{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {"name": "base", "hidden": true, "generator": "Ninja", "binaryDir": "${sourceDir}/build/${presetName}"},
    {"name": "gcc", "hidden": true,
     "cacheVariables": {"CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++"}},
    {"name": "clang", "hidden": true,
     "cacheVariables": {"CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++"}},
    {"name": "release", "hidden": true,
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "PLANCK_CONTRACTS": "auto", "PLANCK_SANITIZE": ""}},
    {"name": "debug", "hidden": true,
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "PLANCK_CONTRACTS": "auto", "PLANCK_SANITIZE": ""}},
    {"name": "checked", "hidden": true,
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "PLANCK_CONTRACTS": "checked", "PLANCK_SANITIZE": ""}},
    {"name": "asan", "hidden": true,
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "PLANCK_CONTRACTS": "checked", "PLANCK_SANITIZE": "address,undefined"}},
    {"name": "tsan", "hidden": true,
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "PLANCK_CONTRACTS": "checked", "PLANCK_SANITIZE": "thread"}},
    {"name": "gcc-release", "inherits": ["base", "gcc", "release"],
     "displayName": "GCC release",
     "description": "GCC: optimised, contracts assumed. The one to measure and to run."},
    {"name": "gcc-debug", "inherits": ["base", "gcc", "debug"],
     "displayName": "GCC debug",
     "description": "GCC: no optimisation, contracts checked. The one to step through."},
    {"name": "gcc-checked", "inherits": ["base", "gcc", "checked"],
     "displayName": "GCC checked",
     "description": "GCC: optimised with debug info, contracts checked. The one to test with."},
    {"name": "gcc-asan", "inherits": ["base", "gcc", "asan"],
     "displayName": "GCC asan",
     "description": "GCC: checked, with AddressSanitizer and UndefinedBehaviorSanitizer."},
    {"name": "gcc-tsan", "inherits": ["base", "gcc", "tsan"],
     "displayName": "GCC tsan",
     "description": "GCC: checked, with ThreadSanitizer."},
    {"name": "clang-release", "inherits": ["base", "clang", "release"],
     "displayName": "Clang release",
     "description": "Clang: optimised, contracts assumed. The one to measure and to run."},
    {"name": "clang-debug", "inherits": ["base", "clang", "debug"],
     "displayName": "Clang debug",
     "description": "Clang: no optimisation, contracts checked. The one to step through."},
    {"name": "clang-checked", "inherits": ["base", "clang", "checked"],
     "displayName": "Clang checked",
     "description": "Clang: optimised with debug info, contracts checked. The one to test with."},
    {"name": "clang-asan", "inherits": ["base", "clang", "asan"],
     "displayName": "Clang asan",
     "description": "Clang: checked, with AddressSanitizer and UndefinedBehaviorSanitizer."},
    {"name": "clang-tsan", "inherits": ["base", "clang", "tsan"],
     "displayName": "Clang tsan",
     "description": "Clang: checked, with ThreadSanitizer."}
  ],
  "buildPresets": [
    {"name": "gcc-release", "configurePreset": "gcc-release"},
    {"name": "gcc-debug", "configurePreset": "gcc-debug"},
    {"name": "gcc-checked", "configurePreset": "gcc-checked"},
    {"name": "gcc-asan", "configurePreset": "gcc-asan"},
    {"name": "gcc-tsan", "configurePreset": "gcc-tsan"},
    {"name": "clang-release", "configurePreset": "clang-release"},
    {"name": "clang-debug", "configurePreset": "clang-debug"},
    {"name": "clang-checked", "configurePreset": "clang-checked"},
    {"name": "clang-asan", "configurePreset": "clang-asan"},
    {"name": "clang-tsan", "configurePreset": "clang-tsan"}
  ],
  "testPresets": [
    {"name": "gcc-release", "configurePreset": "gcc-release",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "gcc-debug", "configurePreset": "gcc-debug",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "gcc-checked", "configurePreset": "gcc-checked",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "gcc-asan", "configurePreset": "gcc-asan",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "gcc-tsan", "configurePreset": "gcc-tsan",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "clang-release", "configurePreset": "clang-release",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "clang-debug", "configurePreset": "clang-debug",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "clang-checked", "configurePreset": "clang-checked",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "clang-asan", "configurePreset": "clang-asan",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}},
    {"name": "clang-tsan", "configurePreset": "clang-tsan",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 8, "timeout": 120}}
  ]
}
